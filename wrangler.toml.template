name = "hhapi"
main = "src/index.ts"
compatibility_date = "2026-06-01"
account_id = "__CF_ACCOUNT_ID__"

[vars]
DATA_VERSION = "2026-06"

[[r2_buckets]]
binding = "GRAPH"
bucket_name = "hhapi-graph"

[[kv_namespaces]]
binding = "CACHE"
id = "__KV_CACHE_ID__"

[[routes]]
pattern = "__CUSTOM_DOMAIN__"
custom_domain = true

[limits]
cpu_ms = 30000

# Per-state D1 shards (one per US state + DC). The bootstrap step provisions
# these and `scripts/materialize_wrangler.sh` substitutes each database_id.
# Bindings are accessed dynamically by the Worker as env[`GEOCODE_${state}`].

[[d1_databases]]
binding = "GEOCODE_AL"
database_name = "hhapi-geo-al"
database_id = "__D1_GEOCODE_AL__"

