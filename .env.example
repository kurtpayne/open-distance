# Copy this file to .env and fill in the values for your Cloudflare account.
# .env is gitignored.

# Required: API token with Workers/D1/R2/KV scope.
# Create one at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# Required: your Cloudflare account ID.
# Find it at https://dash.cloudflare.com (right sidebar of any account page).
CLOUDFLARE_ACCOUNT_ID=

# Required: hostname your Worker will serve under. Must be a domain (or
# subdomain of one) that you control and have proxied through Cloudflare.
# Example: hhapi.example.com
HHAPI_HOSTNAME=

# Required: the API key your Worker will accept on the `key=` query param.
# Generate any opaque string; clients pass this on every request.
HHAPI_API_KEY=
